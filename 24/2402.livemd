```
{:module, Parser, <<70, 79, 82, 49, 0, 0, 13, ...>>, {:decreasing?, 1}}
```

### Tests

```elixir
ExUnit.start(autorun: false)

defmodule ParserTest do
  use ExUnit.Case, async: true
  import Parser

  @input """
  7 6 4 2 1\n1 2 7 8 9\n9 7 6 2 1\n1 3 2 4 5\n8 6 4 4 1\n1 3 6 7 9
  """
  @expected [
              [7, 6, 4, 2, 1],
              [1, 2, 7, 8, 9],
              [9, 7, 6, 2, 1],
              [1, 3, 2, 4, 5],
              [8, 6, 4, 4, 1],
              [1, 3, 6, 7, 9]
            ]

  test "parse test" do
    actual = parse(@input)
    assert actual == @expected
  end

  test "part two - increasing list - valid" do
    actual = increasing?([1,2])
    assert actual == true
  end

  test "part two - increasing list - invalid" do
    actual = increasing?([2,1])
    assert actual == false
  end

  test "part two - decreasing list - valid" do
    actual = decreasing?([2,1])
    assert actual == true
  end

  test "part two - decreasing list - invalid" do
    actual = decreasing?([1,2])
    assert actual == false
  end

  test "part two - threes valid" do
    actual = threes?([2,1])
    assert actual == true
  end

  test "part two - threes invalid" do
    actual = threes?([3,7])
    assert actual == false
  end
end

ExUnit.run()
```

